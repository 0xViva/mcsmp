[Unit]
Description=Vanilla Minecraft 26.3 (rootless podman)
Documentation=file:///home/ajg/servers/mcsmp/README.md
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=mcsmp
Image=localhost/mcsmp-server:25
Pull=never
WorkingDir=/data

# The version lives in VERSION / server.jar; this line stays stable across
# Minecraft updates. JVM flags are in user_jvm_args.txt.
Exec=@user_jvm_args.txt -jar server.jar nogui

# The repo is read-only to the server. Only the save, logs, crash reports,
# and mutable config are writable, so a compromised JVM cannot rewrite the
# scripts or git hooks the host runs.
Volume=/home/ajg/servers/mcsmp:/data:ro
Volume=/home/ajg/servers/mcsmp/world:/data/world:rw
Volume=/home/ajg/servers/mcsmp/logs:/data/logs:rw
Volume=/home/ajg/servers/mcsmp/crash-reports:/data/crash-reports:rw
Volume=/home/ajg/servers/mcsmp/server.properties:/data/server.properties:rw
Volume=/home/ajg/servers/mcsmp/whitelist.json:/data/whitelist.json:rw
Volume=/home/ajg/servers/mcsmp/ops.json:/data/ops.json:rw
Volume=/home/ajg/servers/mcsmp/banned-ips.json:/data/banned-ips.json:rw
Volume=/home/ajg/servers/mcsmp/banned-players.json:/data/banned-players.json:rw
Volume=/home/ajg/servers/mcsmp/usercache.json:/data/usercache.json:rw

# Loopback only: the playit agent on the host is the only thing that may reach
# the server. Nothing is published on the LAN or WAN.
PublishPort=127.0.0.1:25566:25565
# RCON, loopback only: reachable with scripts/rcon.py, not from the LAN.
PublishPort=127.0.0.1:25576:25575

Environment=TZ=Europe/Oslo
ReadOnly=true
Tmpfs=/tmp:rw,size=1g
LogDriver=journald
StopTimeout=120

# Drop everything except the writable data mounts above, and cap CPU so a
# malicious client cannot starve the host or the other server.
# --interactive keeps the container's stdin open so `podman attach` can type
# into the server console (./console).
PodmanArgs=--interactive --memory=6g --pids-limit=2048 --cpus=8 --cap-drop=all --security-opt=no-new-privileges

[Service]
Restart=on-failure
RestartSec=15
TimeoutStopSec=140
# Java exits 143 (128+SIGTERM) after a clean shutdown-hook save.
SuccessExitStatus=143

[Install]
WantedBy=default.target
